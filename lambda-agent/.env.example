# Local dev only — copy to .env and fill in.

# ── OpenRouter ──
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXX
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_SITE_URL=https://github.com/031-Avish/TraceX
OPENROUTER_APP_NAME=TraceX

# ── Slack ──
SLACK_BOT_TOKEN=xoxb-XXXXXXXX
SLACK_CHANNEL_ID=C0XXXXXXXXX

# ── GitHub ──
GITHUB_TOKEN=ghp_XXXXXXXX
GITHUB_REPO_OWNER=your-username
GITHUB_REPO_NAME=acme-payment-service

# ── AWS ──
AWS_REGION=us-east-1
LOG_GROUP_NAME=/ecs/acme-payment-service
METRIC_NAMESPACE=AcmeApp

# ── Agent tuning (optional) ──
AGENT_MAX_TURNS=6
AGENT_WALL_CLOCK_BUDGET_MS=65000
