# Local dev only — copy to .env and fill in. Never commit .env (already gitignored).

# ── Azure AI Foundry / Azure OpenAI ──
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── Slack ──
SLACK_BOT_TOKEN=xoxb-XXXXXXXX
SLACK_CHANNEL_ID=C0XXXXXXXXX

# ── GitHub ──
GITHUB_TOKEN=ghp_XXXXXXXX
GITHUB_REPO_OWNER=your-username
GITHUB_REPO_NAME=acme-payment-service

# ── AWS (also needs `aws configure` / real credentials for the collectors to work) ──
AWS_REGION=us-east-1
LOG_GROUP_NAME=/ecs/acme-payment-service
METRIC_NAMESPACE=AcmeApp

# ── Agent tuning (optional — sane defaults if unset) ──
AGENT_MAX_TURNS=6
AGENT_MAX_TOOL_RESULT_CHARS=4000
AGENT_WALL_CLOCK_BUDGET_MS=65000
